// Prisma schema for the HCE Phoneme Activity Builder — Assessment 2.
//
// Design notes:
// - PostgreSQL runs as its own Docker service ("db" in docker-compose.yml), separate
//   from the Next.js "app" service. Moving off SQLite (a single file inside the app
//   container) means the database has its own lifecycle, its own persistent volume,
//   and handles many simultaneous connections far better under load.
// - `type` on ActivitySet stays a validated String ("WORDLE" | "WORDSEARCH") rather
//   than a Prisma enum, so adding a new activity type later needs no migration.
//   Validation happens in lib/validation.js before any write.
// - Phonemes are stored as their own rows (Phoneme), not as a single delimited string
//   on Word. HCE phoneme symbols can be more than one character (e.g. "tʃ", "ɜː"), so a
//   fixed-width column or a naive split on Word.text would corrupt them. One row per
//   phoneme unit, ordered by `position`, stores each symbol exactly as typed regardless
//   of its length and lets a word's phoneme sequence be read back in order with a
//   simple orderBy.
// - Word lists are reusable. A WordList owns its Words, and an ActivitySet (one saved
//   Wordle or Word Search configuration: title, type, difficulty, hints, theme, and
//   type-specific fields) points at a WordList rather than owning words itself. The
//   same list can therefore back several activities, e.g. a Wordle and a Word Search
//   built from one set of target words, without retyping them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivitySet {
  id         Int      @id @default(autoincrement())
  title      String
  type       String // "WORDLE" | "WORDSEARCH" — validated in lib/validation.js
  difficulty Int      @default(3) // target phoneme count per word (Wordle); informational for Word Search
  maxGuesses Int? // Wordle only
  rows       Int? // Word Search only
  cols       Int? // Word Search only
  showHints  Boolean  @default(true)
  theme      String   @default("light")
  wordListId Int? // the reusable word list this activity draws from
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // SetNull: deleting a word list leaves its activities in place (they just have no
  // list until a teacher picks another one) instead of silently deleting them too.
  wordList WordList? @relation(fields: [wordListId], references: [id], onDelete: SetNull)

  @@index([wordListId])
  @@map("activity_sets")
}

model WordList {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words        Word[]
  activitySets ActivitySet[]

  @@map("word_lists")
}

model Word {
  id         Int      @id @default(autoincrement())
  wordListId Int
  text       String
  hint       String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wordList WordList  @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  phonemes Phoneme[]

  @@index([wordListId])
  @@map("words")
}

model Phoneme {
  id       Int    @id @default(autoincrement())
  wordId   Int
  symbol   String // IPA symbol, may be more than one character (e.g. "tʃ", "ɜː")
  position Int // 0-based order within the word

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("phonemes")
}

// --- Assessment 3: observability / reporting ---
//
// Event is a single, generic log table rather than several purpose-built tables
// (e.g. separate "PageView" and "GenerationLog" tables). Every meaningful thing
// that happens in the app — an activity set being created, a page being viewed,
// an HTML activity being generated or failing to generate — is written here as
// one row. The /api/dashboard route then aggregates this table (counts, averages,
// grouping by type) to produce the metrics the dashboard displays. This keeps the
// schema small while still supporting arbitrary new metrics later without a
// migration, since any new event `type` is just a new string value.
model Event {
  id           Int      @id @default(autoincrement())
  type         String // "ACTIVITY_CREATED" | "PAGE_VIEW" | "GENERATION_SUCCESS" | "GENERATION_FAILURE"
  activityType String? // "WORDLE" | "WORDSEARCH" — set when the event relates to one
  page         String? // e.g. "/wordle" — set for PAGE_VIEW events
  durationMs   Int? // time spent on a page before navigating away or generating — PAGE_VIEW only
  reason       String? // short machine-readable reason — GENERATION_FAILURE only (e.g. "empty_word_list")
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("events")
}
